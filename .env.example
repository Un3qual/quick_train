# Development database
QUICK_TRAIN_POSTGRES_PORT=55433
QUICK_TRAIN_DATABASE_HOST=localhost
QUICK_TRAIN_DATABASE_NAME=quick_train_dev
QUICK_TRAIN_DATABASE_USERNAME=quick_train
QUICK_TRAIN_DATABASE_PASSWORD=quick_train

# Human OIDC authentication
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACKS_JSON={"desktop":"https://client.example.com/oidc/callback"}
OIDC_BEGIN_WINDOW_MS=60000
OIDC_BEGIN_GLOBAL_LIMIT=300
OIDC_BEGIN_NETWORK_LIMIT=20
OIDC_OUTSTANDING_LIMIT=10000
OIDC_TRANSACTION_TTL_SECONDS=300
OIDC_REPLAY_RETENTION_SECONDS=86400
HUMAN_SESSION_MAX_LIFETIME_SECONDS=28800
HUMAN_SESSION_RETENTION_SECONDS=86400

# Comma-separated direct proxy IPs allowed to supply X-Forwarded-For/Proto
TRUSTED_PROXY_IPS=

# Production
PHX_SERVER=true
PHX_HOST=example.com
PORT=4000
DATABASE_URL=ecto://user:password@host/database
DATABASE_SSL=true
SECRET_KEY_BASE=
POOL_SIZE=10
ECTO_IPV6=false
DNS_CLUSTER_QUERY=
