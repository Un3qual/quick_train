# Production
PHX_SERVER=true
PHX_HOST=example.com
PORT=4000
DATABASE_URL=ecto://user:password@host/database
DATABASE_SSL=true
SECRET_KEY_BASE=
POOL_SIZE=10
ECTO_IPV6=false
DNS_CLUSTER_QUERY=
