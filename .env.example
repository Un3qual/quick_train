# Development database
QUICK_TRAIN_POSTGRES_PORT=55433
QUICK_TRAIN_DATABASE_HOST=localhost
QUICK_TRAIN_DATABASE_NAME=quick_train_dev
QUICK_TRAIN_DATABASE_USERNAME=quick_train
QUICK_TRAIN_DATABASE_PASSWORD=quick_train

# Human OIDC authentication
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACKS_JSON={"desktop":"https://client.example.com/oidc/callback"}

# Authentication limit, retention, and trusted-proxy defaults live in config/config.exs.
# Set their documented environment overrides only when deployment-specific values are needed.

# Production
PHX_SERVER=true
PHX_HOST=example.com
PORT=4000
# Required by the default HTTP listener; replace with the TLS-terminating proxy's direct IPs.
TRUSTED_PROXY_IPS=
DATABASE_URL=ecto://user:password@host/database
DATABASE_SSL=true
SECRET_KEY_BASE=
POOL_SIZE=10
ECTO_IPV6=false
DNS_CLUSTER_QUERY=
