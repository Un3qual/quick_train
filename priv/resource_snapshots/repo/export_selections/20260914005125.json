  "base_filter": null,
  "check_constraints": [
    {
      "attribute": [
        "kind"
      ],
      "base_filter": null,
      "check": "  (kind IN ('task','task_input') AND task_id IS NOT NULL AND num_nonnulls(attempt_id,question_id,question_response_id,decision_id,presentation_element_id,question_option_id,label_id,binding_id,dataset_value_id,revision_id,source_record_id,field_definition_id) = 0) OR\n  (kind IN ('attempt','attempt_question','attempt_input_presentation') AND task_id IS NOT NULL AND attempt_id IS NOT NULL AND num_nonnulls(question_id,question_response_id,decision_id,presentation_element_id,question_option_id,label_id,binding_id,dataset_value_id,revision_id,source_record_id,field_definition_id) = 0) OR\n  (kind IN ('question_response','static_option_answer','task_input_answer','text_span','review_decision') AND task_id IS NOT NULL AND question_id IS NOT NULL AND question_response_id IS NOT NULL AND (kind != 'review_decision' OR decision_id IS NOT NULL) AND num_nonnulls(attempt_id,presentation_element_id,question_option_id,label_id,binding_id,dataset_value_id,revision_id,source_record_id,field_definition_id) = 0) OR\n  (kind = 'presentation_element' AND presentation_element_id IS NOT NULL AND num_nonnulls(task_id,attempt_id,question_id,question_response_id,decision_id,question_option_id,label_id,binding_id,dataset_value_id,revision_id,source_record_id,field_definition_id) = 0) OR\n  (kind = 'question_definition' AND question_id IS NOT NULL AND num_nonnulls(task_id,attempt_id,question_response_id,decision_id,presentation_element_id,question_option_id,label_id,binding_id,dataset_value_id,revision_id,source_record_id,field_definition_id) = 0) OR\n  (kind = 'question_option' AND question_id IS NOT NULL AND question_option_id IS NOT NULL AND num_nonnulls(task_id,attempt_id,question_response_id,decision_id,presentation_element_id,label_id,binding_id,dataset_value_id,revision_id,source_record_id,field_definition_id) = 0) OR\n  (kind = 'label' AND label_id IS NOT NULL AND num_nonnulls(task_id,attempt_id,question_id,question_response_id,decision_id,presentation_element_id,question_option_id,binding_id,dataset_value_id,revision_id,source_record_id,field_definition_id) = 0) OR\n  (kind = 'project_input_binding' AND binding_id IS NOT NULL AND field_definition_id IS NOT NULL AND num_nonnulls(task_id,attempt_id,question_id,question_response_id,decision_id,presentation_element_id,question_option_id,label_id,dataset_value_id,revision_id,source_record_id) = 0) OR\n  (kind = 'dataset_value' AND binding_id IS NOT NULL AND dataset_value_id IS NOT NULL AND revision_id IS NOT NULL AND source_record_id IS NOT NULL AND field_definition_id IS NOT NULL AND num_nonnulls(task_id,attempt_id,question_id,question_response_id,decision_id,presentation_element_id,question_option_id,label_id) = 0)\n",
      "name": "export_selections_typed_owner"
    },
    {
      "attribute": [
